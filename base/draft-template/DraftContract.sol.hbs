pragma solidity ^0.8.24;

import {FHE, euint8, externalEuint8} from "@fhevm/solidity/lib/FHE.sol";
import {ZamaEthereumConfig} from "@fhevm/solidity/config/ZamaConfig.sol";

/**
 * @title {{contractDir}}
 * @custom:label {{contractLabel}}
 * @notice Initial template copied to workspace/draft when running `cli starter:add`.
 * @dev Details:
 * - Simplest example of using FHE
 * - You can add more comments here
 * @author {{authorName}}
 * @custom:category {{category}}
 * @custom:chapter {{chapter}}
 * @custom:tags {{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
 * @custom:ui true
 */
contract {{contractName}} is ZamaEthereumConfig {
    /// @notice Ciphertext already stored as internal `euint8`.
    euint8 private _value;

    constructor() {}

    /**
     * @notice Stores encrypted input to contract state.
     * @param inputValue External `euint8` ciphertext from caller.
     * @param inputProof zk proof that validates the input ciphertext.
     */
    function setValue(
        externalEuint8 inputValue,
        bytes calldata inputProof
    ) external {
        // Every comment inside a function is treated as the logic flow of the function
        _value = FHE.fromExternal(inputValue, inputProof);
        FHE.allowThis(_value);
    }

    /**
     * @notice Returns the stored ciphertext.
     * @return Stored `euint8` ciphertext.
     */
    function getResult() public view returns (euint8) {
        return _value;
    }
}
